# ==========================================
# Пример конфигурации Travel Assistant
# Скопируйте этот файл в .env и заполните значения
# ==========================================

# Выбор провайдера LLM: 'openrouter' или 'local'
LLM_PROVIDER=openrouter

# --- OpenRouter настройки ---
# API ключ для OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Доступные модели: https://openrouter.ai/docs/models
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# --- Локальные модели (Ollama / LM Studio) ---
# Если LLM_PROVIDER=local, используются эти настройки
# Убедитесь, что локальный сервер запущен (например, ollama serve)
LOCAL_MODEL_NAME=llama3.2
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama

# --- Эмбеддинги ---
# Модель для векторных эмбеддингов (HuggingFace)
# Доступные модели: https://huggingface.co/models?library=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Общие настройки ---
# Уровень логирования: debug, info, warning, error
LOG_LEVEL=info
